#!/usr/bin/env python
"""Add newly discovered conversations to the Searchat index."""

from __future__ import annotations

import sys
from datetime import datetime

from searchat.agents import iter_providers
from searchat.config import Config, PathResolver
from searchat.core.conversation_filter import exclude_automated_conversations
from searchat.core.unified_indexer import UnifiedIndexer


def main() -> int:
    config = Config.load()
    search_dir = PathResolver.get_shared_search_dir(config)
    indexer = UnifiedIndexer(search_dir, config)

    print("=" * 70)
    print("Searchat - Add Missing Conversations")
    print("=" * 70)
    print(f"Search directory: {search_dir}")
    print()

    all_files: list[str] = []
    for provider in iter_providers():
        for root_dir in provider.discover_dirs(config):
            try:
                pattern = "*.json" if provider.agent_id == "vibe" else "*.jsonl"
                files = list(root_dir.glob(pattern)) if provider.agent_id == "vibe" else list(root_dir.rglob(pattern))
                all_files.extend(str(path) for path in files)
                if files:
                    print(f"[{provider.agent_id}] {root_dir}: {len(files)} files")
            except Exception as exc:
                print(f"[{provider.agent_id}] Failed to scan {root_dir}: {exc}")

    print()
    print(f"Total discovered files: {len(all_files)}")

    new_files, changed_files = indexer.detect_changed_files(all_files)
    new_files = exclude_automated_conversations(
        new_files,
        config.paths.excluded_conversations_dir,
        config,
    )

    print(f"New files: {len(new_files)}")
    print(f"Changed files: {len(changed_files)}")
    print()

    if not new_files and not changed_files:
        print("Index is already up to date.")
        return 0

    response = input("Continue with append-safe indexing? (yes/no): ").strip().lower()
    if response not in {"yes", "y"}:
        print("Cancelled.")
        return 0

    started = datetime.now()
    stats = indexer.index_from_source_files(new_files, changed_file_paths=changed_files)
    if stats.get("exchanges_created", 0) > 0:
        indexer.storage.create_fts_index()

    elapsed = (datetime.now() - started).total_seconds()
    print()
    print("Indexing complete.")
    print(f"Added conversations: {stats.get('new_conversations', 0)}")
    print(f"Updated conversations: {stats.get('updated_conversations', 0)}")
    print(f"Failed conversations: {stats.get('skipped_errors', 0)}")
    print(f"Exchanges created: {stats.get('exchanges_created', 0)}")
    print(f"Elapsed seconds: {elapsed:.2f}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
